export LS_COLORS

# Nice shortcuts and more convenient commonly used functions
alias ls='ls --color -F'
alias ll='ls -FGAhplt'
alias lk='ls -FGAhp'
alias lr='ls -lrt'
cd() { builtin cd "$@"; ls -FGAhp; }
alias c='/usr/bin/clear'
alias hg='history | grep'
alias mkdir='mkdir -p'
alias rmdir='rmdir -p'
alias pkill='pkill -u ${USER}'
alias ..='cd ../'                               # Move up 1 dir.
alias ...='cd ../../'                           # Move up 2 dir.
alias .3='cd ../../../'                         # Move up 3 dir.
alias .4='cd ../../../../'                      # Move up 4 dir.
alias pp='pwd -P'
alias count='ls . | wc -l'  # count the number of files in the current directory
alias filecount='find . -printf "%h\n" | cut -d/ -f-2 | sort | uniq -c | sort -rn'
alias biggest='du -ah . | sort -n -r | head -n 20'  # figure out the biggest file in your dir.
alias dubig='du -h * | sort -h'  # get the sizes of all files in your dir., sorted by size

# Chinook cluster specific alii
alias sq='squeue -A erthquak'  # group-specific jobs in queue
alias scc='sacct --format=JobID,Start,End,Elapsed,NCPUS,NodeList,NTasks -j'  # more detailed sacct
alias filesize='du -ah | sort -rh | head -n 20 > filesize.out'  # export sizes of largest files in dir.
alias lfs_quota='lfs quota -u $USER /import/c1/ERTHQUAK/ -h'  # figure out your total quota usage 
alias interactive='srun -p debug --nodes=1 --exclusive --pty /bin/bash'  # start interactive mode on debug
alias snode='sinfo --Node --long'  # figure out information of each node (type, cores, etc.)
alias show_nodes='scontrol show nodes'  # even more detailed information on each node

