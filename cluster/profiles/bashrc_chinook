# Bryant's bashrc file for Chinook, abridged for version control
# 2026-10-21

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# Enable modules, changing this line may break the modules environment
. /etc/profile.d/modules.sh

# Load default modules for RHEL Chinook 
module purge
module load slurm
module load intel/2022a

# for NEW directories and files, this will grant users
# read and execute permissions (12-June-2012 ARSC email)
# NOTE: also change the default setting in .bash_profile to umask 0022
umask 027

# Nice looking colors with `ls`ing
export CLICOLOR=1
